#!/usr/bin/env python3
"""matugen-preview — 一次跑完所有配色风格，用色块对比效果

用法:
    matugen-preview [图片路径] [--light|--dark|--smart] [--contrast 0.3]
    matugen-preview                       # 默认用当前壁纸

不传图片时按顺序找：
    Clavis 的壁纸 → ~/.config/niri/wallpaper → 报错
"""

import argparse
import json
import os
import subprocess
import sys

SCHEMES = [
    'scheme-tonal-spot', 'scheme-content', 'scheme-fidelity', 'scheme-vibrant',
    'scheme-expressive', 'scheme-fruit-salad', 'scheme-rainbow', 'scheme-neutral',
    'scheme-monochrome', 'scheme-smart',
]

ROLES = ['primary', 'secondary', 'tertiary', 'surface', 'on_surface']


def current_wallpaper() -> str | None:
    clavis = os.path.expanduser('~/.config/clavis/config.json')
    if os.path.exists(clavis):
        try:
            with open(clavis, encoding='utf-8') as f:
                p = (json.load(f).get('wallpaper') or {}).get('path')
            if p and os.path.isfile(p):
                return p
        except Exception:
            pass
    niri = os.path.expanduser('~/.config/niri/wallpaper')
    if os.path.exists(niri):
        p = open(niri, encoding='utf-8').read().strip()
        if p and os.path.isfile(p):
            return p
    return None


def hex_to_rgb(h: str) -> tuple[int, int, int]:
    h = h.lstrip('#')
    if len(h) == 3:
        h = ''.join(c * 2 for c in h)
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def block(hexval: str) -> str:
    r, g, b = hex_to_rgb(hexval)
    return f'\033[48;2;{r};{g};{b}m    \033[0m'


def run_scheme(img: str, scheme: str, mode: str, contrast: float | None) -> dict | None:
    cmd = ['matugen', 'image', img, '-m', mode, '-j', 'hex',
           '--prefer', 'saturation', '--dry-run', '-t', scheme]
    if contrast is not None:
        cmd += ['--contrast', str(contrast)]
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
        if out.returncode != 0:
            return None
        return json.loads(out.stdout)
    except Exception:
        return None


def main() -> int:
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument('image', nargs='?', help='壁纸/图片路径')
    ap.add_argument('--mode', '-m', default='dark', choices=['dark', 'light', 'smart'])
    ap.add_argument('--contrast', type=float, default=None, help='-1 ~ 1，例如 0.3')
    args = ap.parse_args()

    img = args.image or current_wallpaper()
    if not img:
        print('找不到壁纸，请显式给一个图片路径', file=sys.stderr)
        return 1
    if not os.path.isfile(img):
        print(f'文件不存在: {img}', file=sys.stderr)
        return 1

    print(f'\n壁纸: {os.path.basename(img)}   模式: {args.mode}'
          + (f'   对比度: {args.contrast}' if args.contrast is not None else ''))
    print()

    # 表头
    head = f'{"风格":<22}'
    for r in ROLES:
        head += f'{r:<14}'
    print(head)
    print('─' * (22 + 14 * len(ROLES)))

    for scheme in SCHEMES:
        data = run_scheme(img, scheme, args.mode, args.contrast)
        if not data:
            print(f'{scheme:<22}(取色失败)')
            continue
        row = f'{scheme:<22}'
        for r in ROLES:
            try:
                hexv = data['colors'][r][args.mode]['color']
            except (KeyError, TypeError):
                hexv = '#000000'
            row += f'{block(hexv)} {hexv}  '
        print(row)

    print()
    print('提示: 用 -t <风格名> 跑真实取色，例如')
    print('      matugen image <图片> -m dark -t scheme-fidelity --prefer saturation')
    return 0


if __name__ == '__main__':
    sys.exit(main())
