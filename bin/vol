#!/usr/bin/env bash
# vol — 音量键统一入口，带 OSD
#   vol raise|lower|mute
set -uo pipefail

action=${1:-raise}

# 音量一律走 wpctl：Clavis 的 shell 会监听音量变化并自己弹 OSD。
# 如果这里用 swayosd-client，就会出现两套 OSD 同时弹。
# 没有 swayosd 就静默调（mako 不弹提示）
case "$action" in
    raise) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ -l 1.0 ;;
    lower) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
    mute)  wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
esac
