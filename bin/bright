#!/usr/bin/env bash
# bright — 亮度键统一入口，带 OSD
#   bright raise|lower
set -uo pipefail

action=${1:-raise}

# 同上：必须确认 swayosd-server 在跑，否则客户端连不上、亮度完全不动
if command -v swayosd-client >/dev/null 2>&1 && pgrep -x swayosd-server >/dev/null 2>&1; then
    case "$action" in
        raise) swayosd-client --brightness raise >/dev/null 2>&1 && exit 0 ;;
        lower) swayosd-client --brightness lower >/dev/null 2>&1 && exit 0 ;;
    esac
fi

case "$action" in
    raise) brightnessctl --class=backlight set +5% ;;
    lower) brightnessctl --class=backlight set 5%- ;;
esac
