# 由 theme 脚本自动渲染，改主色请改 ~/.config/themes/templates/ghostty-config
# 换主题时会重新生成这个文件

font-family = JetBrainsMono Nerd Font
font-size = 11
font-thicken = true

# 留白：终端贴在窗口边缘很难看
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true

# 终端背景保持不透明，透明度交给 niri 的 window-rule 统一处理，
# 这样和 Konsole 完全一致（否则两处叠加会双重透明）
background-opacity = 1.0

cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

# 配色（跟着主题走）
background = #{{base}}
foreground = #{{text}}
cursor-color = #{{blue}}
cursor-text = #{{base}}
selection-background = #{{surface1}}
selection-foreground = #{{text}}
bold-color = #{{text}}

palette = 0=#{{surface0}}
palette = 1=#{{red}}
palette = 2=#{{green}}
palette = 3=#{{yellow}}
palette = 4=#{{blue}}
palette = 5=#{{purple}}
palette = 6=#{{teal}}
palette = 7=#{{subtext0}}
palette = 8=#{{overlay0}}
palette = 9=#{{red}}
palette = 10=#{{green}}
palette = 11=#{{yellow}}
palette = 12=#{{blue}}
palette = 13=#{{purple}}
palette = 14=#{{teal}}
palette = 15=#{{text}}
